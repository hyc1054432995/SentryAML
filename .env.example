# SentryAML environment variables
# Copy to .env and fill in your own values:   copy .env.example .env   (macOS/Linux: cp)
# .env is listed in .gitignore. Never commit it.

# --- PostgreSQL (docker compose reads these) ---
POSTGRES_USER=sentry
POSTGRES_PASSWORD=change-me
POSTGRES_DB=sentryaml

# Main connection used by the pipeline scripts (the container maps 5432 -> 5433 on the host)
DATABASE_URL=postgresql://sentry:change-me@localhost:5433/sentryaml

# Least-privilege roles. Created by sql/020_investigation.sql and sql/025_review.sql with
# development passwords; change them for anything beyond a local demo.
# The code refuses to fall back to DATABASE_URL if these are missing.
AGENT_DATABASE_URL=postgresql://sentry_agent:sentry_agent_dev@localhost:5433/sentryaml
REVIEW_DATABASE_URL=postgresql://sentry_review:sentry_review_dev@localhost:5433/sentryaml

# --- Model APIs ---
DEEPSEEK_API_KEY=
SILICONFLOW_API_KEY=

# --- Review web app ---
# At least 32 characters; the server refuses to start without it. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
