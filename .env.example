# SentryAML 环境变量
# ---------------------------------------------------------------
# 复制这个文件为 .env 后再改成你自己的值：
#     copy .env.example .env
#
# .env 必须写进 .gitignore，绝对不要提交到 GitHub。
# 这个项目最后要开源，密码泄漏是最常见的低级事故。
# ---------------------------------------------------------------

POSTGRES_USER=sentry
POSTGRES_PASSWORD=change_me_to_something_random
POSTGRES_DB=sentryaml

# 供 Python 侧连接使用（后面 ETL 脚本会读这个）
# 注意 host 是 localhost，因为 Python 跑在宿主机、不在容器里
DATABASE_URL=postgresql://sentry:change_me_to_something_random@localhost:5432/sentryaml
